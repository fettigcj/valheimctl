# config/worlds/04.env - per-world settings (override fleet.env). NO secrets.
# Comments must be on their own line: a value runs to the end of its line.

# World + server name become valheim04-KidWorld
SUFFIX=KidWorld
# Only used when the world is first created
SEED=ChangeMe123
# Per-world game args: this is how "easier" vs "vanilla" is chosen. A -preset must come BEFORE modifiers.
SERVER_ARGS=-modifier raids none
#SERVER_ARGS=-preset hard -modifier raids none
#BEPINEX=false
