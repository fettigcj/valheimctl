# /etc/valheim/fleet.env - fleet-wide defaults. NO secrets in this file.
# Format: KEY=value, one per line. No trailing comments, no shell expansion.
IMAGE=lloesche/valheim-server:latest
UPDATE_HOURS=0,6,12,18
BACKUPS_MAX_COUNT=100
STATUS_HTTP=true
SUPERVISOR_HTTP=true
SUPERVISOR_HTTP_USER=admin
SERVER_PUBLIC=true
BEPINEX=true
ADMINLIST_IDS=7656119XXXXXXXXXX 7656119YYYYYYYYYY
