# fleet.env - settings shared by every world. NO secrets in this file.
# Format: KEY=value, one per line; comments only on their own line.

# docker (default), podman or k8s
BACKEND=docker
IMAGE=lloesche/valheim-server:latest
# Hours (UTC) for update checks; the minute is derived per world to stagger them
UPDATE_HOURS=0,6,12,18
BACKUPS_MAX_COUNT=100
STATUS_HTTP=true
SUPERVISOR_HTTP=true
SUPERVISOR_HTTP_USER=admin
SERVER_PUBLIC=true
BEPINEX=true
ADMINLIST_IDS=7656119XXXXXXXXXX 7656119YYYYYYYYYY

# Kubernetes only (ignored by docker/podman)
#K8S_NAMESPACE=valheim
#K8S_EXPOSE=loadbalancer
#K8S_LB_IP=192.0.2.50
#K8S_STORAGE_CLASS=local-path
#K8S_MEM_REQUEST=2Gi
