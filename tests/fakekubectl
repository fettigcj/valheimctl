# Minimal kubectl stub for tests: records calls, keeps deployment/secret state under $FAKE_K.
K=${FAKE_K:?}; mkdir -p "$K"; echo "kubectl $*" >>"$K/calls.log"
args=(); while [[ $# -gt 0 ]]; do case $1 in --context|-n|--kubeconfig) shift 2;; *) args+=("$1"); shift;; esac; done
set -- "${args[@]}"; verb=$1; shift
jp=; prev=; for a in "$@"; do [[ $a == jsonpath=* ]] && jp=$a; [[ $prev == -o && $a == jsonpath=* ]] && jp=$a; prev=$a; done
rv() { cat "$K/rv" 2>/dev/null || echo 1; }
repl() { if [[ -e $K/replicas ]]; then cat "$K/replicas"; else grep -m1 '^  replicas:' "$K/manifest.txt" 2>/dev/null | awk '{print $2}'; fi; }
case $verb in
  create)
    case $1 in
      namespace) touch "$K/ns"; echo "namespace created";;
      secret) for a in "$@"; do [[ $a == --from-file=* ]] && { kv=${a#--from-file=}; cp "${kv#*=}" "$K/pending.${kv%%=*}"; }; done; echo "kind: Secret";;
    esac;;
  apply)
    in=$(cat)
    if grep -q '^kind: Secret' <<<"$in" || [[ $in == "kind: Secret" ]]; then
      changed=0; for p in "$K"/pending.*; do [[ -e $p ]] || continue; n=${p##*/pending.}
        cmp -s "$p" "$K/secret.$n" 2>/dev/null || changed=1; cp "$p" "$K/secret.$n"; rm -f "$p"; done
      ((changed)) && echo $(( $(rv) + 1 )) >"$K/rv" || { [[ -e $K/rv ]] || echo 1 >"$K/rv"; }
    elif grep -q '^kind: Deployment' <<<"$in"; then printf '%s\n' "$in" >"$K/manifest.txt"; touch "$K/deployed"; rm -f "$K/replicas"
    elif grep -q '^kind: Pod' <<<"$in"; then echo "pod-applied" >>"$K/calls.log"; fi;;
  diff) in=$(cat); if [[ "$in" == "$(cat "$K/manifest.txt" 2>/dev/null)" ]]; then exit 0; else echo "+changed"; exit 1; fi;;
  get)
    case $1 in
      namespace) if [[ ${FAKE_NS_FORBIDDEN:-0} == 1 ]]; then echo "Error from server (Forbidden): namespaces \"x\" is forbidden"; exit 1; fi
        [[ -e $K/ns || ${FAKE_NS_EXISTS:-0} == 1 ]] || { echo "Error from server (NotFound): namespaces \"x\" not found"; exit 1; };;
      pvc|persistentvolumeclaim) cat "$K/world" 2>/dev/null;;
      deployment) [[ -e $K/deployed ]] || exit 1
        case $jp in
          *readyReplicas*spec.replicas*) echo "$(repl)/$(repl)";; *readyReplicas*) [[ $(repl) -gt 0 ]] && echo "$(repl)";;
          *spec.replicas*) repl;;
          *WORLD_NAME*) grep -A1 'name: WORLD_NAME' "$K/manifest.txt" | sed -n 's/.*value: "\(.*\)"/\1/p';;
        esac;;
      pod) [[ -e $K/deployed && $(repl) -gt 0 ]] && echo "valheim-pod-0";;
      secret) [[ -e $K/secret.server_pass ]] || exit 1
        case $jp in *server_pass*) base64 -w0 <"$K/secret.server_pass";; *supervisor_pass*) base64 -w0 <"$K/secret.supervisor_pass" 2>/dev/null;; *resourceVersion*) rv;; esac;;
    esac;;
  exec)
    while [[ $1 == -i ]]; do shift; done; shift   # drop -i and the target
    [[ $1 == -- ]] && shift; X="$*"
    case $X in
      *RESTORED*) cat >"$K/restore-input" 2>/dev/null; echo "kubectl restore-script" >>"$K/calls.log"; echo RESTORED;;
      *ROLLED_BACK*) echo ROLLED_BACK;;
      *status.json*) echo "{\"player_count\": ${FAKE_PLAYERS:-0}, \"players\": []}";;
      "supervisorctl status"*) printf 'valheim-server      RUNNING   pid 22, uptime 8:17:10\n';;
      *_backup_auto*) printf 'g\t20261009-112915\t1452\t19000\ng\t20261009-030936\t1435\t19000\nz\t20261009-110518\t?\t30000\n';;
      *"tar -czf -"*) echo faketar;;
      *"tar -xzf -"*) cat >"$K/imported.tgz"; echo "imported" >>"$K/calls.log";;
      *"test -d"*) [[ ${FAKE_WORLD_IN_POD:-1} == 1 ]];;
      *) echo "exec $X" >>"$K/calls.log";;
    esac;;
  scale) for a in "$@"; do [[ $a == --replicas=* ]] && echo "${a#*=}" >"$K/replicas"; done;;
  annotate) for a in "$@"; do [[ $a == valheimctl.io/world=* ]] && echo "${a#*=}" >"$K/world"; done;;
  logs) echo "Game server connected"; echo "ZNet.LoadWorld: X (w), save number ${FAKE_SAVE:-1000}";;
  delete) if [[ " $* " == *"deployment"* ]]; then rm -f "$K/deployed" "$K/manifest.txt" "$K/replicas"; fi;;
  label|wait|top) :;;
  *) echo "fakekubectl: unsupported $verb" >&2; exit 2;;
esac
